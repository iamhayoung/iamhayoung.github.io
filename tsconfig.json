{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["assets/*"],
      "@components/*": ["src/components/*"],
      "@content/*": ["content/*"],
      "@layouts/*": ["src/layouts/*"],
      "@pages/*": ["pages/*"],
      "@styles/*": ["styles/*"]
    },
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
